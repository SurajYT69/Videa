# TMDB v3 API key. Get one free at https://www.themoviedb.org/settings/api
# Server-side only. Never prefix with NEXT_PUBLIC_.
TMDB_API_KEY=

# Canonical origin, used for OG/Twitter metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MyAnimeList Client ID (https://myanimelist.net/apiconfig). Optional: anime
# pages show MAL score and details when set. Server-side only.
MAL_CLIENT_ID=

# OMDb key (https://www.omdbapi.com/apikey.aspx). Optional: title pages show
# IMDb, Rotten Tomatoes and Metacritic scores when set. Personal,
# non-commercial use only under OMDb's terms. Server-side only.
OMDB_API_KEY=
